From d952fa24a94836aced1788fa0f9a21fac0989cd4 Mon Sep 17 00:00:00 2001
From: Galih Tama <galpt@v.recipes>
Date: 2026-05-17 14:26:55 +0700
Subject: [PATCH] block: add Multi-Lane I/O Scheduler (FLOW) v3.1

Add the Multi-Lane I/O scheduler (flow-iosched), a blk-mq elevator with
three priority tiers (Emergency / Read / Write), deadline-sorted rbtree
dispatch, mq-deadline-style writes_starved anti-starvation, and a 3-mode
autotuner.

Removed in v3.1:
  - Per-process budget containment (caused system hang under sequential
    write loads — budget refill sectors/100 returned 0 for I/Os < 50 KB)
  - Contained lane (now 3 lanes: Emergency > Read > Write)
  - IO profile recomputation, latency credit/debt system

Signed-off-by: Galih Tama <galpt@v.recipes>
---
  block/Kconfig.iosched |   21 +-
  block/flow-iosched.c  | 1143 +++++++++++++++++++++++++++++++------------------
  2 files changed, 743 insertions(+), 421 deletions(-)

diff --git a/block/Kconfig.iosched b/block/Kconfig.iosched
index 7cafef0..b2f002f 100644
--- a/block/Kconfig.iosched
+++ b/block/Kconfig.iosched
@@ -2,17 +2,20 @@ config MQ_IOSCHED_FLOW
 	tristate "Multi-Lane I/O scheduler (FLOW)"
 	default m
 	help
-	  The Multi-Lane I/O scheduler (FLOW) is a blk-mq I/O scheduler with
-	  five priority tiers adapted from the scx_flow CPU scheduling design.
-	  It provides deadline-sorted dispatch, per-process I/O budget
-	  containment, and starvation-safe batching for modern multi-queue
-	  block devices.
+	  The Multi-Lane I/O scheduler (FLOW) v3.0 is a blk-mq I/O scheduler
+	  with four priority tiers, deadline-sorted dispatch, per-process I/O
+	  budget containment with proportional completion-based refill, and
+	  a 3-mode autotuner.
+
+	  Simplified from the original 5-lane scx_flow port to a block-I/O-
+	  native design that removes the IO profile recomputation, latency
+	  credit/debt system, and per-hctx dispatch-list fast path — none
+	  of which added measurable benefit over the simpler model.
 
 	  Tier 0 (Emergency):  Unconditional bypass for BLK_MQ_INSERT_AT_HEAD
-	  Tier 1 (Reserved):   Low-latency path for synchronous reads/metadata
-	  Tier 2 (Latency):    Bounded responsiveness for small random I/O
-	  Tier 3 (Shared):     Background throughput for async writes
-	  Tier 4 (Contained):  Throttled path for I/O hogs
+	  Tier 1 (Read):       Deadline-sorted for synchronous reads/metadata
+	  Tier 2 (Write):      Deadline-sorted for async writes
+	  Tier 3 (Contained):  Throttled path for I/O hogs
 
 config MQ_IOSCHED_DEFAULT_FLOW
 	bool "Enable FLOW I/O scheduler as the default MQ scheduler"
