From: Galih Tama <galpt@v.recipes>
Date: Tue, 12 May 2026 22:22:09 +0700
Subject: [PATCH] flow-iosched: compat fix for kernels 6.12-6.17

Kernels 6.12 through 6.17 pass (request_queue *, elevator_type *) to
init_sched, while 6.18+ pass (request_queue *, elevator_queue *).

Apply after 0001-linux7.0-flow-iosched-v1.0.0.patch to replace the
init_sched function with the older signature and add elevator_alloc().

Signed-off-by: Galih Tama <galpt@v.recipes>
---
 block/flow-iosched.c | 22 ++++++++++++++++++++--
 17 insertions(+), 5 deletions(-)
diff --git a/block/flow-iosched.c b/block/flow-iosched.c
index cd99299..d97afc8 100644
--- a/block/flow-iosched.c
+++ b/block/flow-iosched.c
@@ -872,18 +872,27 @@ static bool flow_has_work(struct blk_mq_hw_ctx *hctx)
 
 /* ── Init / Exit ──────────────────────────────────────────────────── */
 
-/* Kernel 7.x init_sched signature: passes a pre-allocated elevator_queue.
- * For older kernels (6.12-, which pass elevator_type), use the
- * patches/ directory for the compatibility patch.                      */
-static int flow_init_sched(struct request_queue *q, struct elevator_queue *eq)
+/* 6.12-compat init_sched signature: passes a pre-allocated elevator_queue.
+ * For kernel 7.x (6.18+, which passes elevator_queue), apply
+ * the inverse patch from flow-iosched/patches/.                      */
+static int flow_init_sched(struct request_queue *q, struct elevator_type *e)
 {
 	struct flow_data *fd;
+	struct elevator_queue *eq;
 	int ret = -ENOMEM;
 
+	eq = elevator_alloc(q, e);
+	if (!eq) {
+		pr_err("flow-iosched: failed to allocate elevator\n");
+		ret = -ENOMEM;
+		goto out_put_eq;
+	}
+
 	fd = kzalloc_node(sizeof(*fd), GFP_KERNEL, q->node);
 	if (!fd) {
 		pr_err("flow-iosched: failed to allocate flow_data\n");
-		return ret;
+		ret = -ENOMEM;
+		goto out_put_eq;
 	}
 
 	/* Create memory pools */
@@ -970,6 +979,9 @@ destroy_rq_pool:
 	mempool_destroy(fd->rq_data_pool);
 destroy_rq_cache:
 	kmem_cache_destroy(fd->rq_data_cache);
+
+out_put_eq:
+	kobject_put(&eq->kobj);
 free_fd:
 	kfree(fd);
 	return ret;
