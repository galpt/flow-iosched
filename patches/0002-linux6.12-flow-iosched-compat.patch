        From Galih Tama <galpt@v.recipes>  Mon May 18 06:32:18 2026 +0000
        From: Galih Tama <galpt@v.recipes>
        Date: Mon May 18 06:32:18 2026 +0000
        Subject: [PATCH] flow-iosched: compat for 6.12-6.17 init_sched API

        Kernels 6.12 through 6.17 use an older init_sched elevator op signature:
int init_sched(struct request_queue *q, struct elevator_type *e)
instead of the 6.18+ / 7.x signature:      int init_sched(struct
request_queue *q, struct elevator_queue *eq)  This patch adjusts
flow_init_sched() to match the older API by allocating the
elevator_queue and private data itself, and adding kobject_put on the
error path.


        Signed-off-by: Galih Tama <galpt@v.recipes>
        ---

diff --git a/block/flow-iosched.c b/block/flow-iosched.c
index 67d9ad99c8..f6d10b1826 100644
--- a/block/flow-iosched.c
+++ b/block/flow-iosched.c
@@ -609,12 +609,20 @@ static void flow_limit_depth(blk_opf_t opf, struct blk_mq_alloc_data *data)
 
 /* ── Init / exit ───────────────────────────────────────────────── */
 
-static int flow_init_sched(struct request_queue *q, struct elevator_queue *eq)
+static int flow_init_sched(struct request_queue *q, struct elevator_type *e)
 {
-	struct flow_data *fd = eq->elevator_data;
+	struct elevator_queue *eq;
+	struct flow_data *fd;
 
-	if (!fd)
+	eq = elevator_alloc(q, e);
+	if (!eq)
 		return -ENOMEM;
+	fd = kzalloc_node(sizeof(*fd), GFP_KERNEL, q->node);
+	if (!fd) {
+		kobject_put(&eq->kobj);
+		return -ENOMEM;
+	}
+	eq->elevator_data = fd;
 
 	INIT_LIST_HEAD(&fd->prio_queue[0]);
 	INIT_LIST_HEAD(&fd->prio_queue[1]);

