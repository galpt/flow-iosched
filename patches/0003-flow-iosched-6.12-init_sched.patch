From: Galih Tama <galpt@v.recipes>
Date: Tue, 12 May 2026 21:31:43 +0700
Subject: [PATCH] flow-iosched: compatibility fix for kernels 6.12–6.17

Kernels 6.12 through 6.17 use the older init_sched callback signature
that passes (request_queue *, elevator_type *) instead of the kernel
7.x signature (request_queue *, elevator_queue *).

This patch adjusts flow_init_sched to call elevator_alloc() itself and
updates the error cleanup path accordingly.

Signed-off-by: Galih Tama <galpt@v.recipes>
---
 block/flow-iosched.c | 20 +++++++++++++++-----
 1 file changed, 15 insertions(+), 5 deletions(-)

diff --git a/block/flow-iosched.c b/block/flow-iosched.c
index 1234567..89abcde 100644
--- a/block/flow-iosched.c
+++ b/block/flow-iosched.c
@@ -876,9 +876,19 @@ static void flow_exit_sched(struct elevator_queue *e)
  * Kernel 6.18+ passes a pre-allocated elevator_queue.
  * Kernel 6.12–6.17 passes elevator_type and expects the scheduler to call
  * elevator_alloc().  Apply this patch for the older signature.
+ *
+ *   6.12 – 6.17:
+ *     static int flow_init_sched(struct request_queue *q,
+ *                                struct elevator_type *e)
+ *
+ *   6.18+:
+ *     static int flow_init_sched(struct request_queue *q,
+ *                                struct elevator_queue *eq)
  */
-static int flow_init_sched(struct request_queue *q, struct elevator_queue *eq)
+static int flow_init_sched(struct request_queue *q, struct elevator_type *e)
 {
+	struct elevator_queue *eq;
 	struct flow_data *fd;
 	int ret = -ENOMEM;
 
@@ -888,6 +898,12 @@ static int flow_init_sched(struct request_queue *q, struct elevator_queue *eq)
 		return ret;
 	}
 
+	eq = elevator_alloc(q, e);
+	if (!eq) {
+		pr_err("flow-iosched: failed to allocate elevator\n");
+		goto free_fd;
+	}
+
 	fd->rq_data_cache = kmem_cache_create(...);
 	if (!fd->rq_data_cache) {
 		pr_err("flow-iosched: failed to create rq_data cache\n");
@@ -956,8 +972,8 @@ static int flow_init_sched(struct request_queue *q, struct elevator_queue *eq)
 	return 0;
 
 destroy_rq_pool:
-	mempool_destroy(fd->rq_data_pool);
+	mempool_destroy(fd->rq_data_pool); /* falls through */
 destroy_rq_cache:
 	kmem_cache_destroy(fd->rq_data_cache);
 free_fd:
+	kobject_put(&eq->kobj);
 	kfree(fd);
 	return ret;
 }
